# Общие настройки (токены бизнесов — в БД)
DATABASE_URL=postgresql://postgres:postgres@db:5432/salesbot

# PostgreSQL (для docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=salesbot

# Aitunnel (общий для всех бизнесов)
OPENAI_API_KEY=sk-aitunnel-ваш_ключ
OPENAI_BASE_URL=https://api.aitunnel.ru/v1
AI_MODEL=claude-haiku-4.5

# Администратор платформы (ваш Telegram ID)
ADMIN_IDS=[7738750071]

# Общие настройки
FOLLOWUP_DELAY_SECONDS=3600
MAX_TOKENS=500
AI_TEMPERATURE=0.7